@0  = ~Chwała ci za twe czyny w Soubar, <CHARNAME>. Mam nadzieję, że nie było ci dane doświadczyć zbyt wielu przygód od naszego ostatniego spotkania. Wiem, że podróże na tak daleką północ Amn mogą być uciążliwe.~ [CB_77259]
@1  = ~Jak już ci mówiliśmy, więcej o czyhających w Warowni Lyrara rozbójnikach i bandytach możesz dowiedzieć się od burmistrza Melandora.~ [CB_77260]
@2  = ~Porozmawiaj z burmistrzem Melandorem. Powie ci wszystko, co należy zrobić z Niechybnym Ostrzem i bandytami atakującymi Soubar i gospodarstwa.~ [CB_77261] 
@3  = ~Powodzenia w straży. Kiedy zaczynałem moją karierę wojownika, byłem w Straży Waterdeep. Dali mi tam niezły wycisk.~ [CB_77262]
@4  = ~Pamiętam, jak byłem strażnikiem w Straży Waterdeep. Powiem ci, że pierwszych parę dni było koszmarem. Jako najniższy rangą całe warty musiałem spędzać na bramie obserwując jedną z prowadzących do miasta dróg. Wachmistrz, pod którego komendą byłem, kazał mi co trzeci patrol wykonywać w dokach. Raz na tydzień dodatkowo miałem patrolować drogę przez wzgórza na północny zachód od miasta.~ [CB_77263] 
@5  = ~Nauczyłem się chociaż spać na stojąco.~ [CB_77264]
@6  = ~Taa, to był żart. Jeśli prefekt nadmiernie będzie cię cisnął, to pamiętaj, że to dla dobra Soubar.~ [CB_77265]
@7  = ~Więcej o swoich przygodach w straży możesz mi poopowiadać później. Teraz mam coś do zrobienia.~ [CB_77266] 
@8  = ~Co, oficer, hę? Świetnie. Masz już rozkazy? Jestem pewien, że prefekt wkrótce przydzieli ci jakiś oddział.~ [CB_77267]
@9  = ~Dobry wieczór. Mam nadzieję, że korzystasz z oficerskiego życia. W Straży Waterdeep nigdy nie miałem na to szansy, bo odszedłem z niej na długo przez tym, gdy mógłbym dostać awans na oficera.~ [CB_77268]
@10 = ~Rotmistrz <CHARNAME>! Czy prefekt sprecyzował, o co chcielibyśmy cię prosić?~ [CB_77269]
@11 = ~Tak, wasza lordowska mość.~
@12 = ~Nie, lordzie Varrosie.~ 
@13 = ~Dobrze. Czy zgadzasz się przyjąć stanowisko adiutanta Straży Soubar?~ [CB_77270]
@14 = ~Tak, wasza lordowska mość.~ 
@15 = ~Nie, wasza lordowska mość. Nie mogę przyjąć tej nominacji. Przykro mi, ale muszę wrócić do Athkatli. Mam tam sporo do zrobienia i muszę już ruszać.~
@16 = ~Doskonale. Zatem bez dalszej zwłoki niniejszym mianuję cię adiutantem Soubar. Adiutancie, pełnij swoje obowiązki dobrze, a czeka cię nagroda.~ [CB_77271]
@17 = ~Przykro mi to słyszeć. Byłoby to godnym uhonorowaniem twoich zasług dla Soubar. Na pewno nie przyjmiesz tej nominacji?~ [CB_77272]
@18 = ~W porządku, wasza lordowska mość. Przyjmę stanowisko adiutanta.~ 
@19 = ~Wybacz mi, lordzie Varrosie. Muszę zrezygnować.~
@20 = ~Dobrze. Szanuję twoją decyzję. Mam nadzieję, że nie padniemy już ofiarą takiego ataku, jak poprzednio.~ [CB_77273]
@21 = ~W takim razie przepraszam. Miałem wrażenie, że owszem. Porozmawiaj zatem, proszę, z prefektem.~ [CB_77274]
@22 = ~Adiutant <CHARNAME>! Reasumując, zawsze starałem się unikać rozlewu krwi, jednak po wymierzonym w Soubar ataku Niechybnego Ostrza i jego bandy, nie mogę dłużej trzymać się tych zasad. Zostaw mnie i znajdź tego mordercę. Przynieś mi jego głowę.~ [CB_77275]
@23 = ~Wiem, że nigdy nie byłbym w stanie stanąć twarzą w twarz z Rolfem Niechybne Ostrze i powrócić jako zwycięzca. Jednak tobie udało się tego dokonać, dając dowód twojej dzielności, odwadze i umiejętnościom. Świetna robota, <CHARNAME>.~ [CB_77276]
@24 = ~Ufam, że teraz, kiedy obrano cię burmistrzem Soubar, potrzebni ci będą doświadczeni dyplomaci do rządzenia miastem?~ [CB_77277]
@25 = ~Tak, Gajuszu. Potrzebuję kogoś twojego pokroju, aby tu pozostał i opiekował się Soubar. Zostań i zachowaj odpowiednią dla swoich niemałych zdolności politycznych pozycję w radzie miejskiej.~
@26 = ~Nie, Gajuszu. Członkami Rady miejskiej Soubar mianowałem moich kompanów, a miasto nie może mieć zbyt wielu radnych. Proszę cię, mimo że dobrze służyłeś Meladorowi, zrezygnuj.~ ~Nie, Gajuszu. Członkami Rady miejskiej Soubar mianowałam moich kompanów, a miasto nie może mieć zbyt wielu radnych. Proszę cię, mimo że dobrze służyłeś Meladorowi, zrezygnuj.~
@27 = ~Oczywiście, będę służył Soubar razem z tobą.~ [CB_77278]
@28 = ~<CHARNAME>, jestem już zmęczony polityką i z chęcią ustąpię.~ [CB_77279]
@29 = ~Wrócę do Waterdeep, zostawiając w twoich zdolnych rękach miasto i lud Soubar.~ [CB_77280]
@30 = ~To było jednak najlepsze sześć lat mego życia. Spędziłem dużo czasu na strażnicy, ale w końcu przeniesiono mnie do oddziału patrolującego Doki.~ [CB_77281]
@31 = ~To była ciężka praca, jednak wraz z kolegami wykonywaliśmy ją dobrze. Nie raz zostaliśmy tam obici, zapoznając się jednocześnie z ciemniejszą stroną Waterdeep, ale za to w koszarach to sobie wynagradzaliśmy.~ [CB_77282]
@32 = ~Adiutant, <CHARNAME>! Zostaw mnie i porozmawiaj z prefektem. Znajdź Niechybne Ostrze i przynieś jego głowę.~ [CB_77283]