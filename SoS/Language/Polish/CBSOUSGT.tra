@0    = ~TY TAM! PREFEKT CHCE CIĘ NATYCHMIAST ZWERBOWAĆ! NAJPIERW, BACZNOŚĆ!~
@1    = ~TAK JEST, WACHMISTRZU!~ 
@2    = ~Uspokój się. Ranisz me uszy tym krzyczeniem i wrzeszczeniem. Stoję tutaj.~
@3    = ~DOBRZE. WEŹ SWÓJ EKWIPUNEK Z DROGI I UBIERZ SIĘ W MUNDUR!~
@4    = ~POWIEDZIAŁEM, BACZNOŚĆ!~
@5    = ~Cicho tam, szeregowcu Benjamin.~
@6    = ~TAK JEST, WACHMISTRZU!~ 
@7    = ~MAMY TUTAJ INTRYGANTA, PREFEKCIE!~
@8    = ~BACZNOŚĆ TERAZ, STRAŻNIKU, ALBO BĘDZIESZ ŻAŁOWAŁ, ŻE SIĘ URODZIŁEŚ!~ ~BACZNOŚĆ TERAZ, STRAŻNIK, ALBO BĘDZIESZ ŻAŁOWAŁA, ŻE SIĘ URODZIŁAŚ!~
@9    = ~Już dobrze. TAK JEST, WACHMISTRZU!~
@10   = ~Aye, aye, admirale Dupogłowy.~
@11   = ~W SAMĄ PORĘ! DAJ MI TERAZ WSZYSTKIE RZECZY, KTÓRE NOSISZ. NIE MASZ PRAWA DO NOSZENIA WŁASNEGO EKWIPUNKU, GDY JESTEŚ POD MOJĄ KOMENDĄ W MILICJI SOUBAR. TO WSZYSTKO JEST TERAZ MOJE! DAWAJ TO TU!~
@12   = ~PREFEKT OSTRZEGŁ CIĘ O KARACH ZA PRZETRZYMYWANIE RZECZY. NIE CHCĘ SŁYSZEĆ ŻADNYCH SKARG.~
@13   = ~I MAM NADZIEJĘ, ŻE NIE CHOWASZ NICZEGO W JAKICHŚ POJEMNIKACH DOOKOŁA MIASTA. WYŚLĘ CAŁY ODDZIAŁ, ŻEBY UPEWNIĆ SIĘ, ŻE NIE UKRYŁEŚ NICZEGO.~ ~I MAM NADZIEJĘ, ŻE NIE CHOWASZ NICZEGO W JAKICHŚ POJEMNIKACH DOOKOŁA MIASTA. WYŚLĘ CAŁY ODDZIAŁ, ŻEBY UPEWNIĆ SIĘ, ŻE NIE UKRYŁAŚ NICZEGO.~
@14   = ~NIE MOŻESZ NICZEGO UŻYWAĆ, KIEDY JESTEŚ POD MOJĄ KOMENDĄ!~
@15   = ~W PORZĄDKU. JAZDA, UBIERAĆ SIĘ W MUNDURY.~
@16   = ~MYŚLISZ, ŻE TO ZABAWNE? CO?~
@17   = ~SŁUCHAĆ STRAŻNIKU, ZBIÓRKA, ALBO WYŚLĘ CIĘ DO TURMY! A TERAZ, BACZNOŚĆ!~ ~SŁUCHAĆ STRAŻNIK, ZBIÓRKA, ALBO WYŚLĘ CIĘ DO TURMY! A TERAZ, BACZNOŚĆ!~
@18   = ~Jesteśmy na wsi. Tu nie ma zamku.~
@19   = ~OOOOCCHHH... MAMY TUTAJ, BBŁŁAAAAZNA! CÓŻ, PANIE BŁAAAŹŹNIEE, JAK CI SIĘ UŚMIECHA SĄD WOJENNY?~ ~OOOOCCHHH... MAMY TUTAJ, BBŁŁAAAAZNA! CÓŻ, PANI BŁAAAZEN, JAK CI SIĘ UŚMIECHA SĄD WOJENNY?~
@20   = ~W porządku, widzę, że stoimy w miejscu. Do rzeczy, wachmistrzu.~
@21   = ~RUSZAĆ SIĘ, STRAŻNIKU! SPOTKACIE MNIE PRZY DRODZE NA PÓŁNOC! ŚPIESZYĆ SIĘ! NIE MAMY CZASU, ABY SIĘ OBIJAĆ!~ ~RUSZAĆ SIĘ, STRAŻNIK! SPOTKACIE MNIE NA DRODZE NA PÓŁNOC! ŚPIESZYĆ SIĘ! NIE MAMY CZASU, ABY SIĘ OBIJAĆ!~
@22   = ~MAM TEŻ DOKUMENTY I IDENTYFIKATOR, KTÓRE CI TERAZ DAJĘ. NIE ZGUB ICH. ANI SWOJEGO MUNDURU.~
@23   = ~TO WSZYSTKO, POROZMAWIAJ Z PREFEKTEM, ABY DOSTAĆ NOWE ROZKAZY.~
@24   = ~TU JESTEŚCIE, STRAŻNIKU. TWOJE ROZKAZY SĄ TERAZ NAPRAWDĘ PROSTE!~ ~TU JESTEŚCIE, STRAŻNIK. TWOJE ROZKAZY SĄ TERAZ NAPRAWDĘ PROSTE!~
@25   = ~CO MAMY ROBIĆ, WACHMISTRZU?~
@26   = ~MASZ PATROLOWAĆ TĘ DROGĘ. NIE POZWÓL, ABY JAKIKOLWIEK BANDYTA DOSTAŁ SIĘ DO MIASTA. A I BĄDŹ OSTROŻNY, BO MOGĄ ZJAWIĆ SIĘ W KAŻDEJ CHWILI. BĘDĘ TUTAJ NA POSTERUNKU, JEŚLI BĘDZIESZ POTRZEBOWAŁ POMOCY, UDERZĘ W DZWON NA ALARM. TO WSZYSTKO ŻOŁNIERZU. WYKONAĆ ROZKAZY!~ ~MASZ PATROLOWAĆ TĘ DROGĘ. NIE POZWÓL, ABY JAKIKOLWIEK BANDYTA DOSTAŁ SIĘ DO MIASTA. A I BĄDŹ OSTROŻNA, BO MOGĄ ZJAWIĆ SIĘ W KAŻDEJ CHWILI. BĘDĘ TUTAJ NA POSTERUNKU, JEŚLI BĘDZIESZ POTRZEBOWAŁA POMOCY, UDERZĘ W DZWON NA ALARM. TO WSZYSTKO ŻOŁNIERZU. WYKONAĆ ROZKAZY!~
@27   = ~DOBRZE, STRAŻNIKU. WSZYSCY BANDYCI, KTÓRZY PRÓBOWALI ZAATAKOWAĆ SOUBAR ZOSTALI WYBICI LUB POHARATANI.~ ~DOBRZE, STRAŻNIK. WSZYSCY BANDYCI, KTÓRZY PRÓBOWALI ZAATAKOWAĆ SOUBAR ZOSTALI WYBICI LUB POHARATANI.~
@28   = ~CIESZĘ SIĘ, ŻE KTOŚ TAKI, JAK TY, JEST PO NASZEJ STRONIE.~
@29   = ~MUSZĘ POINFORMOWAĆ PREFEKTA. POWINIEN WIEDZIEĆ, CO TU SIĘ DZIAŁO. I WYSŁAĆ WIĘCEJ LUDZI, ABY UTRZYMAĆ PATROLE.~
@30   = ~SPOTKAJ SIĘ ZE MNĄ I PREFEKTEM W KOSZARACH, GDY TYLKO BĘDZIESZ MÓGŁ. BĘDZIEMY OMAWIAĆ KWESTIĘ DALSZYCH POSUNIĘĆ. ODMASZEROWAĆ!~ ~SPOTKAJ SIĘ ZE MNĄ I PREFEKTEM W KOSZARACH, GDY TYLKO BĘDZIESZ MOGŁA. BĘDZIEMY OMAWIAĆ KWESTIĘ DALSZYCH POSUNIĘĆ. ODMASZEROWAĆ!~
@31   = ~Dziękuję, wachmistrzu!~
@32   = ~ZŁOŻYŁEM RAPORT PREFEKTOWI. MA DLA CIEBIE NOWE ROZKAZY. CHCE CIĘ W TEJ CHWILI WIDZIEĆ. ZAMELDOWAĆ SIĘ U NIEGO NATYCHMIAST, STRAŻNIKU!~ ~ZŁOŻYŁEM RAPORT PREFEKTOWI. MA DLA CIEBIE NOWE ROZKAZY. CHCE CIĘ W TEJ CHWILI WIDZIEĆ. ZAMELDOWAĆ SIĘ U NIEGO NATYCHMIAST, STRAŻNIK!~
@33   = ~MNIEMAM, ŻE ZROZUMIAŁEŚ ROZKAZY I JESTEŚ GOTÓW, STRAŻNIKU?~ ~MNIEMAM, ŻE ZROZUMIAŁAŚ ROZKAZY I JESTEŚ GOTOWA, STRAŻNIK?~
@34   = ~TAK JEST, WACHMISTRZU! GOTOWI DO WYMARSZU!~
@35   = ~Nie! Jeszcze nie!~
@36   = ~IDZIEMY DO FARM NA PÓŁNOC OD SOUBAR. SZYBKO, STRAŻNIKU!~ ~IDZIEMY DO FARM NA PÓŁNOC OD SOUBAR. SZYBKO, STRAŻNIK!~
@37   = ~DAJ MI ZNAĆ, KIEDY BĘDZIESZ GOTOWY. MUSIMY ZBADAĆ, CO SIĘ STAŁO Z PATROLEM.~ ~DAJ MI ZNAĆ, KIEDY BĘDZIESZ GOTOWA. MUSIMY ZBADAĆ, CO SIĘ STAŁO Z PATROLEM.~
@38   = ~W PORZĄDKU, ŻOŁNIERZU. MUSIMY UDAĆ SIĘ NA PÓŁNOCNY WSCHÓD. BANDYCI! JEŚLI TO MOŻLIWE, BRAĆ ICH ŻYWCEM. UŻYJ OTRZYMANEJ OD MAJORA LUNETY, BY USTALIĆ ICH POZYCJĘ, I OBSERWUJ ICH, DOPÓKI NIE ZAATAKUJESZ. CHCEMY, ABY TO BYŁA ZASADZKA.~
@39   = ~URATUJ, KOGO SIĘ DA, I PRZYPROWADŹ ICH TUTAJ. JEŚLI NA FARMIE ZNAJDZIEMY KOGOŚ PRZY ŻYCIU, BĘDĘ MÓGŁ STWIERDZIĆ, ŻE MISJA ZAKOŃCZYŁA SIĘ POWODZENIEM I WRÓCIMY DO SOUBAR.~
@40   = ~OBSERWUJ ICH TYLKO, JESTEM PEWIEN, ŻE SĄ TEŻ INNI, ALE CZAJĄ SIĘ POZA ZASIĘGIEM WZROKU.~
@41   = ~CO MASZ DO ZAMELDOWANIA, ZOŁNIERZU?~
@42   = ~Zlikwidowałem wszystkich bandytów na tym terenie.~ ~Zlikwidowałam wszystkich bandytów na tym terenie.~
@43   = ~Nie mam jeszcze nic do zameldowania.~
@44   = ~ODCHODZĘ! Mam już dość tego twojego krzyczenia i wrzeszczenia na mnie. Narka.~
@45   = ~DOBRA ROBOTA, STRAŻNIKU! COŚ JESZCZE?~ ~DOBRA ROBOTA, STRAŻNIK! COŚ JESZCZE?~
@46   = ~Tak jest. Znalazłem tego chłopca ukrywającego się w jabłoniach na północ od naszej pozycji. Mieszkał tam z ojcem - rolnikiem, wujkiem i matką. Był świadkiem ataku i sądzę, że byłoby nierozsądnym pozostawienie go tutaj, w przypadku, gdyby bandyci wrócili.~ ~Tak jest. Znalazłam tego chłopca ukrywającego się w jabłoniach na północ od naszej pozycji. Mieszkał tam z ojcem - rolnikiem, wujkiem i matką. Był świadkiem ataku i sądzę, że byłoby nierozsądnym pozostawienie go tutaj, w przypadku, gdyby bandyci wrócili.~
@47   = ~Nie, to wszystko.~
@48   = ~CO Z MOIM ODDZIAŁEM? WIESZ, CO SIĘ STAŁO Z ODDZIAŁEM ZWIADOWCZYM?~
@49   = ~Z żalem informuję, że nie. Charlie widział atak, ale nie widział nikogo w mundurze Straży Soubar. Nie sądzę, by tutaj byli, a jeśli nawet, to odeszli, zanim rolnicy się obudzili.~
@50   = ~OZNACZA TO KOLEJNY PROBLEM. NIE DOŚĆ, ŻE NIE MOŻEMY IM POMÓC, TO JESZCZE MAMY ZAGINIONYCH W AKCJI. ALE PRZEDE WSZYSTKIM MUSIMY WYPEŁNIAĆ OBOWIĄZKI.~
@51   = ~NIE MAMY TU JUŻ NIC DO ROBOTY. WRACAJMY DO SOUBAR~
@52   = ~Tak jest. Weźmiemy chłopca?~
@53   = ~Tak jest.~
@54   = ~DOBRZE, STRAŻNIKU. ALE BĘDZIESZ MUSIAŁ MU ZAPEWNIĆ OPIEKĘ W SOUBAR.~ ~DOBRZE, STRAŻNIK. ALE BĘDZIESZ MUSIAŁA MU ZAPEWNIĆ OPIEKĘ W SOUBAR.~
@55   = ~POSPIESZ SIĘ, ZANIM BANDYCI WEZMĄ SIĘ ZA SOUBAR! A TERAZ ZABIERAJMY SIĘ STĄD I ZNAJDŹMY MÓJ ODDZIAŁ!~
@56   = ~NIE OCZEKIWAŁEM CIĘ!~
@57   = ~STRAŻNIKU, PRZEKAŻĘ PREFEKTOWI PARĘ SŁÓW O TWOICH CZYNACH W GOSPODARSTWIE NA PÓŁNOCY. A TERAZ ODPOCZNIJ.~ ~STRAŻNIK, PRZEKAŻĘ PREFEKTOWI PARĘ SŁÓW O TWOICH CZYNACH W GOSPODARSTWIE NA PÓŁNOCY. A TERAZ ODPOCZNIJ.~
@58   = ~STRAŻNIKU <CHARNAME>, POKRYJ, WYRÓWNAJ!~ ~STRAŻNIK <CHARNAME>, POKRYJ, WYRÓWNAJ!~
@59   = ~PREFEKT CHCE ZAMIENIĆ Z TOBĄ PARĘ SŁÓW, STRAŻNIKU.~ ~PREFEKT CHCE ZAMIENIĆ Z TOBĄ PARĘ SŁÓW, STRAŻNIK.~
@60   = ~JESTEŚMY W TEJ SAMEJ RANDZE. NIE MUSISZ MI JUŻ SALUTOWAĆ, ANI MNIE SŁUCHAĆ. POROZMAWIAJ Z PREFEKTEM!~
@61   = ~Wachmistrzu, mój odział wpadł w zasadzkę i został częściowo wybity. Muszę natychmiast zgromadzić nowych ludzi. Proszę o to.~
@62   = ~Spocznij, wachmistrzu.~
@63   = ~OCZYWIŚCIE. PRZYGOTUJĘ DLA CIEBIE ODDZIAŁ PRZED KOSZARAMI. BĘDZIE CZEKAĆ NA TWOJE ROZKAZY JUŻ ZA CHWILĘ.~
@64   = ~PANIE ROTMISTRZU! POTRZEBUJE PAN CZEGOŚ?~ ~PANI ROTMISTRZYNI! POTRZEBUJE PANI CZEGOŚ?~
@65   = ~Nie tym razem, wachmistrzu, spocznij.~
@66   = ~Powiedz mi, co się stanie z więźniami w celach pod nami.~
@67   = ~PANIE OFICERZE? PYTA PAN O PODEJRZANEGO O SZPIEGOSTWO, CZY O UCHODŹCÓW Z TRIEL?~ ~PANI OFICER? PYTA PANI O PODEJRZANEGO O SZPIEGOSTWO, CZY O UCHODŹCÓW Z TRIEL?~
@68   = ~O uchodźców. Co się z nimi stanie ?~
@69   = ~O szpiega. Co się z nim stanie?~
@70   = ~OFERUJEMY IM SZANSĘ PRZYŁĄCZENIA SIĘ DO NAS, LEPSZE TO, NIŻ GDYBY MIELI TYLKO MARNOWAĆ NASZE ZAPASY SIEDZĄC W CELACH. PRAWDOPODOBNIE PRZEJDĄ TRENING NA STRAŻNIKÓW.~
@71   = ~MOGĘ PANA Z NIM ZAPOZNAĆ, PANIE OFICERZE! JEST CAŁKIEM NIEZŁY W UCZENIU ŻOŁNIERZY FECHTUNKU.~ ~MOGĘ PANIĄ Z NIM ZAPOZNAĆ, PANI OFICER! JEST CAŁKIEM NIEZŁY W UCZENIU ŻOŁNIERZY FECHTUNKU.~
@72   = ~PROSZĘ SKIEROWAĆ SIĘ W STRONĘ ZACHODNIEJ KRAWĘDZI MIASTA, TO GO PAN SPOTKA, BĘDZIE NA POLU ĆWICZEŃ, ROTMISTRZU!~ ~PROSZĘ SKIEROWAĆ SIĘ W STRONĘ ZACHODNIEJ KRAWĘDZI MIASTA, TO GO PANI SPOTKA, BĘDZIE NA POLU ĆWICZEŃ, ROTMISTRZYNI!~
@73   = ~ZAKŁADAM, ŻE ZOSTANIE POSTAWIONY PRZED SĄDEM, GDY PROBLEMY Z BANDYTAMI SIĘ SKOŃCZĄ. NIE CHCĘ NAWET ZGADYWAĆ, JAKI MOŻE ZAPAŚĆ WYROK, PANIE OFICERZE!~ ~ZAKŁADAM, ŻE ZOSTANIE POSTAWIONY PRZED SĄDEM, GDY PROBLEMY Z BANDYTAMI SIĘ SKOŃCZĄ. NIE CHCĘ NAWET ZGADYWAĆ, JAKI MOŻE ZAPAŚĆ WYROK, PANI OFICER!~
@74   = ~PANIE OFICERZE? PRZESŁUCHAŁ PAN UCHODŹCÓW Z TRIEL?~ ~PANI OFICER? PRZESŁUCHAŁA PANI UCHODŹCÓW Z TRIEL?~
@75   = ~Tak. Co się z nimi stanie?~
@76   = ~POTRZEBUJESZ CZEGOŚ, KADECIE?~ ~POTRZEBUJESZ CZEGOŚ, KADET?~
@77   = ~BURMISTRZ <CHARNAME>. CZEGOŚ CI POTRZEBA?~ ~PANI BURMISTRZ <CHARNAME>. CZEGOŚ CI POTRZEBA?~