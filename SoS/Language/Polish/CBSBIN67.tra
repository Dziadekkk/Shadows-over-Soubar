@0  = ~Patrzcie tylko, kogo my tutaj mamy? Podróżnik w mojej zapyziałej tawernie.~ ~Patrzcie tylko, kogo my tutaj mamy? Podróżniczka w mojej zapyziałej tawernie.~
@1  = ~Pozwól więc, że cię powitam w "Pod Rozszczepionym Stopniem". To moja tawerna, a ja jestem Ludwig Kross. Mieszkam tu i żyję z moją rodziną, a uszczęśliwi nas spełnienie wszelkich twoich życzeń. Mnie prawie zawsze spotkać możesz za głównym kontuarem, moja żona trudni się z kolei roznoszeniem drinków, a moje dzieci, Karl i Laura, zajmują się pracami domowymi.~
@2  = ~Teraz, kiedy już wiesz, kim jesteśmy, czy jest coś, w czym mógłbym pomóc? Potrzebowałbyś może czegoś?~ ~Teraz, kiedy już wiesz, kim jesteśmy, czy jest coś, w czym mógłbym pomóc? Potrzebowałabyś może czegoś?~
@3  = ~Mogę zobaczyć, co oferujesz?~
@4  = ~Byłbym zachwycony, gdybyś znał w Soubar jakieś zacne miejsce, gdzie mógłbym dokonać zakupów.~ ~Byłabym zachwycona, gdybyś znał w Soubar jakieś zacne miejsce, gdzie mogłabym dokonać zakupów.~
@5  = ~Pod Rozszczepionym Stopniem? Niezbyt częsta nazwa dla tawerny. Dlaczego ją tak nazwałeś?~
@6  = ~Niczego nie potrzebuję. Pójdę już.~
@7  = ~Pewnie. Jestem zaszczycony. Tutaj jest mój cennik. Rzuć okiem.~
@8  = ~Wszystko zależy od tego, czego szukasz.~
@9  = ~Jakiegoś przyzwoitego sklepu dla poszukiwaczy przygód?~
@10 = ~Powiedziano mi, że potrzebuję nowego krawca, bo moje ubrania są straszne.~
@11 = ~Nie miałem nic w ustach, odkąd jadłem psi gulasz z żołędziami z Zagajnika Driad. Znasz może jakąś dobrą restaurację?~ ~Nie miałam nic w ustach, odkąd jadłam psi gulasz z żołędziami z Zagajnika Driad. Znasz może jakąś dobrą restaurację?~
@12 = ~Cóż, w tej chwili w Soubar działają trzy sklepy. Możesz do nich zajrzeć. Ja jednak nie mam o nich dobrego zdania, możesz u nich kupić broń, zbroję i inny sprzęt.~
@13 = ~Doskonale. Zajrzę tam. Ale jak już tu jestem, to zobaczę, co masz do zaoferowania.~
@14 = ~Zajrzę do nich. Dzięki.~
@15 = ~Czy potrzebujesz jeszcze czegoś?~
@16 = ~Póki co, nie. Do widzenia.~
@17 = ~Tak, mogę zobaczyć, co masz do zaoferowania?~
@18 = ~Dobrze. Ale jeśli potrzebowałbyś czegoś, daj mi znać.~ ~Dobrze. Ale jeśli potrzebowałabyś czegoś, daj mi znać.~
@19 = ~Moja żona robi ubrania. Szyje naprawdę dobrze. Z nią mógłbyś porozmawiać o ubraniach, bo nie sądzę, by ktokolwiek inny w Soubar potrafił uszyć ubranie i sprzedawał je.~ ~Moja żona robi ubrania. Szyje naprawdę dobrze. Z nią mogłabyś porozmawiać o ubraniach, bo nie sądzę, by ktokolwiek inny w Soubar potrafił uszyć ubranie i sprzedawał je.~
@20 = ~Doskonale. Zajrzę tam. Ale jak już tu jestem, to zobaczę, co masz do zaoferowania.~
@21 = ~Porozmawiam z nią. Dziękuję.~
@22 = ~Ach, mój wesoły przyjacielu! Masz szczęście! "Pod Rozszczepionym Stopniem" to najlepsza restauracja po tej stronie Suzail! Śmiało, śmiało, idź prosto na górę. Któraś z moich córek będzie szczęśliwa mogąc ci pomóc.~ ~Ach, moja wesoła przyjaciółko! Masz szczęście! "Pod Rozszczepionym Stopniem" to najlepsza restauracja po tej stronie Suzail! Śmiało, śmiało, idź prosto na górę. Któraś z moich córek będzie szczęśliwa mogąc ci pomóc.~
@23 = ~Dzięki. Dokładnie tam się teraz udam.~
@24 = ~Doskonale. Ale jak już tu jestem, chciałbym zobaczyć, co masz do zaoferowania.~ ~Doskonale. Ale jak już tu jestem, chciałabym zobaczyć, co masz do zaoferowania.~
@25 = ~Bardzo dobrze. Powiedz jej, że ja cię przysłałem, a przygotuje ci coś naprawdę smacznego.~
@26 = ~Wiesz, tak naprawdę nigdy nie zastanawiałem się nad tym. Kiedyś przeglądałem te głupie książki autorstwa Volo - znasz te jego relacje z podróży - i tam opisywał karczmę o tej samej nazwie, mieszczącej się w Waterdeep. Pomyślałem sobie, dlaczego nie nazwać tak samo mojej tawerny? Jest dużo zajazdów zwanych "Śpioch", czy coś w tym stylu, inne czerpią nazwę od właściciela, jak "Tawerna Menela", ja chciałem czegoś nowego, czegoś, co nie będzie miało związku z tymi prostackimi nazwami.~
@27 = ~Te schody są bezpieczne? Znaczy, czy nie wejdą mi drzazgi, gdy będę po nich szedł.~ ~Te schody są bezpieczne? Znaczy, czy nie wejdą mi drzazgi, gdy będę po nich szła.~
@28 = ~Oczywiście, że nie! To tylko nazwa. Schody są bezpieczne. Nie chciałbym, aby komukolwiek stał się krzywda. Mógłby potem wnieść skargę i dopiero miałbym kłopot.~
@29 = ~Więc chcesz wynająć pokój, czy coś w tym stylu?~
@30 = ~Witaj ponownie w "Pod Rozszczepionym Stopniem". W czym mogę pomóc tym razem?~
@31 = ~Byłbym zachwycony, gdybyś znał jakieś zacne miejsce, gdzie mógłbym dokonać zakupów.~ ~Byłabym zachwycona, gdybyś znał jakieś zacne miejsce, gdzie mogłabym dokonać zakupów.~
@32 = ~Hej! To tobie zawdzięczamy zlikwidowanie bandytów w twierdzy Lyrara!~
@33 = ~Witaj w "Pod Rozszczepionym Stopniem". Śmiało, śmiało, co mogę zrobić dla ciebie?~
@34 = ~Ach, mój przyjacielu. Witaj ponownie w "Pod Rozszczepionym Stopniem". Co u ciebie?~ ~Ach, moja przyjaciółko. Witaj ponownie w "Pod Rozszczepionym Stopniem". Co u ciebie?~
@35 = ~Słyszałem, że rywalizujesz z Melandorem o stanowisko burmistrza Soubar. Cóż, pozwól mi zapewnić cię, że masz poparcie rodziny Krossów.~
@36 = ~Będę na ciebie głosować. Moja żona Jill Ann również.~
@37 = ~Co mogę dla ciebie uczynić?~
@38 = ~Burmistrzu! Witaj ponownie w "Pod Rozszczepionym Stopniem". Chciałbyś coś zjeść, wypić, czy może tylko odpocząć w spokoju od polityki?~ ~Pani burmistrz! Witaj ponownie w "Pod Rozszczepionym Stopniem". Chciałabyś coś zjeść, wypić, czy może tylko odpocząć w spokoju od polityki?~