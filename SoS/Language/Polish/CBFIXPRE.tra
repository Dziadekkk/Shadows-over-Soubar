@0  = ~Witaj, <GABBER>. Witam w Zakonie Promiennego Serca. Czy jest coś, co mógłbym dla ciebie zrobić?~
@1  = ~Nie, prałacie, przepraszam, że przeszkadzam.~
@2  = ~Prałacie. Z całym szacunkiem, ale jestem tu, aby dostarczyć ci wiadomość. Poinstruowano mnie, abym zaczekał na odpowiedź.~ ~Prałacie. Z całym szacunkiem, ale jestem tu, aby dostarczyć ci wiadomość. Poinstruowano mnie, abym zaczekała na odpowiedź.~
@3  = ~Oczekuję na twą odpowiedź, prałacie. Podjąłeś decyzję?~
@4  = ~W porządku, ale wpierw będę musiał się z tym zapoznać.~
@5  = ~Jeśli zechciałbyś poczekać chwilę, przeczytam to dokładnie.~ ~Jeśli zechciałabyś poczekać chwilę, przeczytam to dokładnie.~
@6  = ~Nie, <GABBER>, jeszcze nie. Muszę to przedyskutować z innymi członkami Zakonu.~
@7  = ~Będziesz musiał powrócić do prefekta bez odpowiedzi. Powiedz mu, że przyślę swoją odpowiedź poprzez posłańca tak szybko, jak tylko zdołam.~ ~Będziesz musiała powrócić do prefekta bez odpowiedzi. Powiedz mu, że przyślę swoją odpowiedź poprzez posłańca tak szybko, jak tylko zdołam.~
@8  = ~W porządku, prałacie. Dziękuję za poświęcony czas.~
@9  = ~Niech Torm cię błogosławi, mój synu.~ ~Niech Torm cię błogosławi, moja córko.~
@10 = ~<GABBER>. Zakonu Promiennego Serca nie cieszy twój widok. Mów i zostaw nam tę sprawę.~
@11 = ~Po prostu dam ci ten list. Weź go i nic tu po mnie.~
@12 = ~Nic, "prałacie".~
@13 = ~Najbardziej cieszę się z tego, że nie masz innych spraw do mnie. Daj mi go i skończmy to.~
@14 = ~Weź go, a sobie pójdę, "prałacie".~
@15 = ~W takim razie proszę, abyś zostawił mnie w spokoju, albo wezwę straże.~ ~W takim razie proszę, abyś zostawiła mnie w spokoju, albo wezwę straże.~
@16 = ~Witaj, <GABBER>. Witam ponownie w Zakonie. Czy jest coś, co mógłbym dla ciebie zrobić?~
@17 = ~Tak, wasza wielebność. Mam dostarczyć ci tę wiadomość, poinstruowano mnie także, abym zaczekał na odpowiedź. Jednakże musisz mi wybaczyć, ponieważ jest to sprawa najwyższej wagi, proszę więc, byś odpowiedział natychmiast.~ ~Tak, wasza Wielebność. Mam dostarczyć ci tę wiadomość, poinstruowano mnie także, abym zaczekała na odpowiedź. Jednakże musisz mi wybaczyć, ponieważ jest to sprawa najwyższej wagi, proszę więc, byś odpowiedział natychmiast.~
@18 = ~Nic, prałacie Wessalen. Przepraszam, że przeszkadzam, z pewnością masz ważniejsze rzeczy, którymi musisz się zająć.~
@19 = ~Przepraszam, że znowu przeszkadzam, prałacie Wessalen, jednak zostałem poinstruowany, aby wrócić do prefekta Soubar z odpowiedzią. Co mam mu powiedzieć?~ ~Przepraszam, że znowu przeszkadzam, prałacie Wessalen, jednak zostałam poinstruowana, aby wrócić do prefekta Soubar z odpowiedzią. Co mam mu powiedzieć?~
@20 = ~Oczywiście, mój chłopcze. Zajmę się tym natychmiast. Daj mi go przeczytać, to powiem ci, co o tym sądzę.~ ~Oczywiście, moje dziewczę. Zajmę się tym natychmiast. Daj mi go przeczytać, to powiem ci, co o tym sądzę.~
@21 = ~Wygląda to poważnie, mój bracie. Musisz dać mi chwilę na przeczytanie. Na moją odpowiedź zaczekaj w sąsiedniej komnacie.~ ~Wygląda to poważnie, moja siostro. Musisz dać mi chwilę na przeczytanie. Na moją odpowiedź zaczekaj w sąsiedniej komnacie.~
@22 = ~<CHARNAME>, powinieneś wiedzieć, jak ważny jest dla mnie każdy członek Zakonu. Zawsze staram się znaleźć czas, by pomóc im w ich problemach. W żaden więc sposób nie mógłbyś mi przeszkadzać.~ ~<CHARNAME>, powinnaś wiedzieć, jak ważny jest dla mnie każdy członek Zakonu. Zawsze staram się znaleźć czas, by pomóc im w ich problemach. W żaden więc sposób nie mogłabyś mi przeszkadzać.~
@23 = ~Przepraszam, mój synu, ale nie miałem szansy, by przedyskutować to z innymi przywódcami Zakonu.~ ~Przepraszam, moja córko, ale nie miałem szansy, by przedyskutować to z innymi przywódcami Zakonu.~ 
@24 = ~Ta sprawa może pozostać nie rozpatrzona do następnego spotkania. Nie jestem pewien, kiedy będziemy mogli się spotkać, i chociaż wiem, że musisz się bardzo spieszyć, a prefekt jest w wielkiej potrzebie, będziesz jednak musiał wrócić do niego bez odpowiedzi.~ ~Ta sprawa może pozostać nie rozpatrzona do następnego spotkania. Nie jestem pewien, kiedy będziemy mogli się spotkać, i chociaż wiem, że musisz się bardzo spieszyć, a prefekt jest w wielkiej potrzebie, będziesz jednak musiała wrócić do niego bez odpowiedzi.~
@25 = ~Idź już, <CHARNAME>. Prefektowi zaś powiedz, że przedstawię tę sprawę rycerzom Zakonu i podejmiemy decyzję, niech jednak nie spodziewa się szybkiej odsieczy.~
@26 = ~Aczkolwiek zagrożenie ze strony, napadających na niewinną ludność, bandytów i zbirów jest czymś, czego Zakon tolerować nie może, więc, według wszelkiego prawdopodobieństwa, zdecydujemy się przybyć Soubar z pomocą.~
@27 = ~<CHARNAME>, niech błogosławieństwo Torma, jak i moje, towarzyszy ci podczas podróży.~