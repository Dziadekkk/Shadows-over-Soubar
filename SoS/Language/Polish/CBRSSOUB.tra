@0    = ~Hej, ludzie! Dokonaliśmy tego! Triel leży u naszych stóp!~ [CB_74193]
@1    = ~Spowodowaliśmy, że nasi wrogowie lękają się stawić nam czoła! Spowodowaliśmy, że kulą się ze strachu! Podbiliśmy tych, którzy się nas nie bali!~ [CB_74194]
@2    = ~Będziemy dalej zastraszać naszych wrogów, dopóki nie zaczną respektować naszych praw do rządzenia tutejszymi ludźmi, jak nam się to podoba!~ [CB_74195]
@3    = ~Nie ma niczego, co może powstrzymać nasze podboje! Jednak, ludzie, mamy jeszcze wiele do zrobienia! Musimy podbić Soubar, zanim weźmiemy się za Elturel! Jeśli ma się to udać, musimy dołożyć wszelkich starań, by stać się znaczącą siłą w tej krainie!~ [CB_74196]
@4    = ~Hej, ludzie! Musimy odbudować ten zamek, by na powrót stał się budzącą grozę fortecą! Musimy splądrować gospodarstwa wokół Soubar! Musimy przeniknąć do miasta i je zdeprawować! Musimy także zebrać sojuszników!~ [CB_74197]
@5    = ~Wiele jest do zrobienia, moi ludzie! Ale jesteśmy do tego zdolni! Zrealizujemy nasze cele! *Podbijemy* Soubar!~ [CB_74198]
@6    = ~Nic nas nie powstrzyma!~ [CB_74199]