@0    = ~Tak jest, rotmistrzu!~ ~Tak jest, rotmistrzyni!~
@1    = ~Czekam na rozkazy, rotmistrzu!~ ~Czekam na rozkazy, rotmistrzyni!~
@2    = ~Żołnierzu, patroluj ulice Soubar, do czasu otrzymania ode mnie nowych rozkazów.~
@3    = ~Żołnierzu, udaj się na północno-zachodnią drogę wjazdową do Soubar. Migiem!~
@4    = ~Żołnierzu, będziesz chronił główną drogę prowadzącą do miasta od północy. Zamelduj się na swoim posterunku!~
@5    = ~Chroń północną drogę wjazdową do miasta, żołnierzu! Zamelduj się tam natychmiast!~
@6    = ~Żołnierzu, chroń mnie nawet za cenę swego marnego życia! Jeśli ktoś mnie zaatakuje, zabij go. Jeśli nie ma zagrożenia, podążaj za mną!~ 
@7    = ~Żołnierzu, chroń <PLAYER2>. Chroń <PLAYER2> za cenę swego życia.~
@8    = ~Żołnierzu, chroń <PLAYER3>. Chroń <PLAYER3> za cenę swego życia.~
@9    = ~Żołnierzu, chroń <PLAYER4>. Chroń <PLAYER4> za cenę swego życia.~
@10   = ~Żołnierzu, chroń <PLAYER5>. Chroń <PLAYER5> za cenę swego życia.~
@11   = ~Żołnierzu, chroń <PLAYER6>. Chroń <PLAYER6> za cenę swego życia.~
@12   = ~Żołnierzu, baczność! Zostań tu, aż do odwołania.~
@13   = ~Tak jest!~