@0    = ~Cieszę się, że przybywasz bezpiecznie. Jestem zaszczycony, że możemy cię gościć w naszym mieście.~ [CB_76960]
@1    = ~Jak już mówiłem na Wzgórzach Umar, burmistrz Melandor może powiedzieć ci wszystko na temat bandytów w Warowni Lyrara.~ [CB_76961]
@2    = ~Rozumiem, że Sirrus chce przyjąć cię do Straży Soubar. Powodzenia. Jestem pewien, że twoje umiejętności pozwolą ci stać się doskonałym strażnikiem.~ [CB_76962]
@3    = ~Jak to jest być strażnikiem? Jestem pewien, że prefekt sprawi, że braknie ci czasu na bezczynność.~ [CB_76963]
@4    = ~Zatem przyjęto cię do straży. Gratuluję.~ [CB_76964]
@5    = ~Słyszałem wieści. Twoja pomoc była jedyną nadzieją dla Soubar i cieszę się, że nasze małe miasteczko otrzymało ją od ciebie. Dziękuję za wszystko.~ [CB_76965]
@6    = ~Burmistrz <CHARNAME>! Mam nadzieję, że potrzebujesz kogoś w charakterze radnego?~ [CB_76966]
@7    = ~Nie. Zostałeś odwołany ze swojego stanowiska. Mianowałem własnych radnych, ale Soubar dziękuje za twą wierną służbę.~ ~Nie. Zostałeś odwołany ze swojego stanowiska. Mianowałam własnych radnych, ale Soubar dziękuje za twą wierną służbę.~
@8    = ~Tak, pozostaniesz w Radzie Miejskiej.~
@9    = ~Dobrze. <CHARNAME>, służyć Soubar i tobie było zaszczytem. Wrócę do mojego ojczystego Cormyru. Powodzenia.~ [CB_76967]
@10   = ~Będę więc służył Soubar i tobie najlepiej, jak potrafię.~ [CB_76968]
@11   = ~Jestem naprawdę zmartwiony, że nie możemy ci pomóc w trakcie całej podróży do Soubar. Mam jednak nadzieję, że nie przytrafi ci się jakiś nieprzewidziany wypadek.~ [CB_76969]
@12   = ~Zawsze wypełniam dla niego raporty lub piszę jego rozkazy. Nie jestem nawet członkiem straży, a dla niego pracuję.~ [CB_76970]
@13   = ~Jestem pewien, że Sirrus i prefekt szybko cię awansują, twoje umiejętności znacznie przewyższają te strażników miejskich, cechuje cię też znaczna biegłość w charakterze poszukiwacza przygód.~ [CB_76971]