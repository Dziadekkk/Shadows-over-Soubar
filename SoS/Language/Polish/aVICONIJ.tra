@0    = ~<CHARNAME>, musisz po³o¿yæ temu kres.~
@1    = ~Viconio, nie obchodzi mnie w co wierzysz, ale Lloth jest z³¹ bogini¹ i musi zostaæ zniszczona! Nie mo¿na okazaæ jej litoœci.~
@2    = ~O co chodzi, Viconio?~
@3    = ~Dziecko, nie wiesz, co zamierzasz. Jeœli zabijesz boginiê, nawet tak¹, któr¹ uwa¿asz za z³¹, to zaburzysz ca³¹ strukturê Panteonu. NIE MO¯ESZ TEGO ZROBIÆ!~
@4    = ~Najwidoczniej boisz siê, ¿e mi siê uda. A wiêc, Viconio, Lloth zabi³a wiêcej niewinnych, ni¿ ktokolwiek zdo³a³by policzyæ, i dlatego zniszczê j¹ dzisiaj!~
@5    = ~<CHARNAME>, ze wzglêdu na wszystko, co razem przeszliœmy, dajê ci ostatni¹ szansê. Nie brnij w to dalej, albo bêdê zmuszona ciê powstrzymaæ.~
@6    = ~Dobrze, Viconio, sama tego chcia³aœ! Zginiesz tak¿e!~
@7    = ~Przykro mi, Viconio, ale musisz zrozumieæ, ¿e ona jest z³a i trzeba j¹ zniszczyæ. Nie ma innego wyjœcia.~
@8    = ~<CHARNAME>, bêdê zmuszona ciê powstrzymaæ, jeœli nie wycofasz siê. To mój obowi¹zek jako drowki.~
@9    = ~Nie pozwolê na to, Viconio. Muszê to zrobiæ dla siebie i Faerunu.~
@10   = ~To ostatnie ostrze¿enie.~
@11   = ~Powstrzymam ciê, nawet jeœli bêdê musia³a oddaæ ¿ycie za Lloth.~
@12   = ~To nie musi siê tak koñczyæ, Viconio. ChodŸ z nami i kontynuujmy nasz¹ przygodê.~
@13   = ~Nie, <CHARNAME>, zobaczy³am, do czego jesteœ zdolny, jak myœlisz i do czego mo¿esz siê posun¹æ. Nie mogê pozwoliæ, byœ mnie gdzieœ zostawi³ i powróci³ tu, by zniszczyæ moj¹ boginiê. Albo ja zabijê ciebie, albo ty mnie. Nie ma innego wyjœcia. Nie mo¿emy d³u¿ej tego ci¹gn¹æ. Przygotuj siê, zaraz spróbujê ciê powstrzymaæ.~ ~Nie, <CHARNAME>, zobaczy³am, do czego jesteœ zdolna, jak myœlisz i do czego mo¿esz siê posun¹æ. Nie mogê pozwoliæ, byœ mnie gdzieœ zostawi³a i powróci³a tu, by zniszczyæ moj¹ boginiê. Albo ja zabijê ciebie, albo ty mnie. Nie ma innego wyjœcia. Nie mo¿emy d³u¿ej tego ci¹gn¹æ. Przygotuj siê, zaraz spróbujê ciê powstrzymaæ.~
@14   = ~<CHARNAME>, jestem drowk¹. Bez Lloth nie istnia³abym. Jeœli zamierzasz zg³adziæ stworzycielkê ca³ego gatunku drowów, to muszê u¿yæ ca³ej mej si³y, by ciê powstrzymaæ.~
@15   = ~Viconio, Lloth nie stworzy³a drowów. To drowy stworzy³y Lloth. Nie widzisz tego?~
@16   = ~Nie widzê nic, oprócz ¿¹dnego w³adzy œmiertelnika, który próbuje zniszczyæ wszystko, co mi drogie; wszystko, co œwiête dla mnie i mego ludu.~
@17   = ~Tak wiêc mê¿czyzna naziemiec zostaje burmistrzem Soubar, podczas gdy drowka jest tylko cz³onkiem Rady. O, nie! <CHARNAME>, zrobi³am wiêcej od ciebie. Chcê byæ traktowana na równi. Chcê tak¿e byæ burmistrzem.~ ~Wiêc naziemiec zostaje burmistrzem Soubar, podczas gdy drow jest tylko cz³onkiem Rady. O, nie! <CHARNAME>, zrobi³am wiêcej od ciebie. Chcê byæ traktowana na równi. Chcê tak¿e byæ burmistrzem.~
@18   = ~Ale, Viconio, ka¿de miasto mo¿e mieæ tylko jednego burmistrza.~
@19   = ~Wiêc uratuj w³asne miasto i tam zostañ burmistrzem. Soubar jest moje.~
@20   = ~Dobrze, Viconio, mo¿esz byæ burmistrzem.~
@21   = ~Œwietnie, dzieciê, niech tak bêdzie.~
@22   = ~Nie, na bogów. <CHARNAME>, jesteœ burmistrzem Soubar. Mo¿esz robiæ to, czego sobie za¿yczysz. I ¿yczysz sobie, ¿ebym sta³a siê burmistrzem. Rozumiesz?~
@23   = ~Nie. Chcê *to* miasto.~
@24   = ~Hê? Naprawdê? Po namyœle stwierdzam jednak, ¿e nie mogê zostaæ burmistrzem. Mam zbyt du¿o nienawiœci i z³oœci wobec mieszkañców Soubar - tych s³abych g³upców, którzy nie potrafi¹ nawet ochroniæ w³asnego miasta. Zatrzymaj sobie tê posadkê.~