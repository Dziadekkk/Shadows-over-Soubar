@0    = ~Jak ja to robię? Ja tylko rzucam rzutkami. Chcesz zagrać?~
@1    = ~Nie teraz, może później.~
@2    = ~Pewnie. Jakie są stawki?~
@3    = ~W porządku. Tylko jeszcze trochę poćwiczę.~
@4    = ~Co powiesz na sztukę złota dla tego, kto wygra?~
@5    = ~Przyjąłeś zakład.~ ~Przyjęłaś zakład.~
@6    = ~Traf w dziesiątkę.~
@7    = ~W porządku, ja zaczynam.~
@8    = ~To zakład, więc ja zaczynam.~
@9    = ~Wygląda na to, że wygrałeś, przyjacielu.~ ~Wygląda na to, że wygrałaś, pani.~
@10   = ~Oto twoja wygrana - sztuka złota. Tylko nie wydaj wszystkiego od razu.~
@11   = ~Gra z tobą to przyjemność. Jeśli chcesz zagrać jeszcze raz, to daj mi tylko znać.~
@12   = ~Nie teraz, możesz jeszcze trochę porzucać, jeśli chcesz.~
@13   = ~Dobra, zagrajmy jeszcze raz.~
@14   = ~Oto twoja wygrana - dziesięć sztuk złota. Dobrej zabawy!~
@15   = ~Wygląda na to, że wygrałem, przyjacielu, więc płać.~ ~Wygląda na to, że wygrałem, pani, więc płać.~
@16   = ~Tak, tak zrobię.~
@17   = ~Jesteś pewien? To na pieniędze.~ ~Jesteś pewna? To na pieniędze.~
@18   = ~Tak, zagrajmy o 10 sztuk złota.~
@19   = ~Zagramy o moje złoto.~
@20   = ~Zakład przyjęty.~