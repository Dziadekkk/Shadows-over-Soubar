@0  = ~Witam. Czym mogę szanownemu Panu służyć?~ ~Witam. Czym mogę szanownej Pani służyć?~
@1  = ~Przepraszam za nietakt, Wielki Kupcu, ale jestem tutaj w ważnej sprawie. Prefekt Soubar przysłał mnie, bym dostarczył list.~ ~Przepraszam za nietakt, Wielki Kupcu, ale jestem tutaj w ważnej sprawie. Prefekt Soubar przysłał mnie, bym dostarczyła list.~
@2  = ~Czy miałeś już możliwość zapoznać się dokładnie z listem od prefekta?~
@3  = ~Nic. Przepraszam, że przeszkadzam, Wielki Kupcu.~
@4  = ~Masz dostarczyć mi list od prefekta Soubar? Od dłuższego czasu nie miałem od niego żadnych wieści. Co tam u niego?~
@5  = ~Tak, Wielki Kupcu. Mam list. Dlaczego nie spojrzysz na niego. Prefekt wyraża w nim swój żal.~
@6  = ~Prefekt jest zdenerwowany tymi całymi atakami na Soubar. Nie wygląda to za dobrze.~
@7  = ~Bardzo dobrze. Zostaw go tutaj, a ja niezwłocznie go przeczytam.~
@8  = ~Przykro mi to słyszeć. Czy jest coś, co mogę zrobić?~
@9  = ~Dlaczego sam nie przeczytasz listu i nie zdecydujesz. Dlaczego nie rzucisz nań okiem?~
@10 = ~List wszystko wyjaśnia i zawiera prośbę o pomoc. Dlaczego nie rzucisz nań okiem?~
@11 = ~Pracuję dla prefekta, on sam ma się dobrze, ale sytuacja w Soubar już nie całkiem. Spójrz proszę.~
@12 = ~No, dobrze. Zobaczmy ten list.~
@13 = ~Oczywiście. Przeczytam list natychmiast. Dlaczego nie usiądziesz i nie dasz mi na to chwili.~
@14 = ~Tak, pozwól mi spojrzeć na list, o którym wspomniałeś.~ ~Tak, pozwól mi spojrzeć na list, o którym wspomniałaś.~
@15 = ~Przepraszam, ale potrzebuję chwili, by go przeczytać.~
@16 = ~W rzeczy samej, mam. Ale nie mam żadnej możliwości, by zdecydować, czy Targowo może pomóc poczciwemu prefektowi lub samemu Soubar.~
@17 = ~Będę musiał przedyskutować tę sprawę z moimi współpracownikami tutaj, w Targowie.~
@18 = ~Wszystkim tutaj rządzi polityka, a ja mam związane ręce. Nie wolno mi nawet myśleć o tym, na co nie zezwolą mi tutejsi możni, dlatego nie chcę zatrzymywać cię ani chwili dłużej, niż to już zrobiłem.~
@19 = ~Musisz wrócić do Soubar i prefekta bez odpowiedzi na jego prośbę, jednak proszę cię o przekazanie mu prywatnej wiadomości, że zagrożenie to traktuję poważnie. Uczynię wszystko, co będę mógł dla niego i jego miasta.~
@20 = ~Zapewnij go, niech wie, że w ciągu dziesięciodnia poślę mu odpowiedź, a mam nadzieję, że i, oczywiście w porozumieniu z możnymi Targowa, wsparcie.~
@21 = ~Nie lubi zbyt długo czekać, więc lepiej by było, byś wyruszył jak najszybciej. Szerokiej drogi.~ ~Nie lubi zbyt długo czekać, więc lepiej by było, byś wyruszyła jak najszybciej. Szerokiej drogi.~
@22 = ~<CHARNAME>, witam ponownie. Mam nadzieję, że dobrze się podróżowało? Pamiętaj, że w Targowie zawsze jesteś mile widziany.~ ~<CHARNAME>, witam ponownie. Mam nadzieję, że dobrze się podróżowało? Pamiętaj, że w Targowie zawsze jesteś mile widziana.~
@23 = ~Miło cię widzieć ponownie, Loganie. Trochę czasu minęło od naszego ostatniego spotkania.~
@24 = ~Dziękuję, Loganie. Doceniam twoją gościnność.~
@25 = ~Logan, wygląda na to, że jestem etatowym chłopcem na posyłki. Powiem ci, że to się nigdy nie skończy.~ ~Logan, wygląda na to, że jestem etatową dziewczynką na posyłki. Powiem ci, że to się nigdy nie skończy.~
@26 = ~Nic, Loganie. Przepraszam, że przeszkadzam.~
@27 = ~Loganie, muszę wrócić do Soubar z konkretną odpowiedzią dla prefekta. Czy podjęliście już decyzję w sprawie wsparcia Targowa dla Soubar?~
@28 = ~W rzeczy samej, tak jest, <CHARNAME>. Nie sądzę, byś przybył tu dla pogawędki. Co cię nurtuje tym razem?~ ~W rzeczy samej, tak jest, <CHARNAME>. Nie sądzę, byś przybyła tu dla pogawędki. Co cię nurtuje tym razem?~
@29 = ~Od pewnego czasu pracuję dla prefekta Soubar, który koniecznie potrzebuje wsparcia dla miasta.~
@30 = ~Soubar? Pracujesz teraz dla Żulesa? <CHARNAME>, to świetnie. Wspólnie przeszliśmy niejedno - wiesz, byliśmy razem w Armii Tethyru, aż do Krwawych Dni Eleintu. Nie było to coś, co chciałbym pamiętać.~
@31 = ~Logan, powinieneś przeczytać ten list. Prefekt prosił mnie, bym ci go dostarczył, w nadziei, że mu pomożesz. Dlatego chociaż go przejrzyj.~ ~Logan, powinieneś przeczytać ten list. Prefekt prosił mnie, bym ci go dostarczyła, w nadziei, że mu pomożesz. Dlatego chociaż go przejrzyj.~
@32 = ~Prefekt? Ma na imię Żules? Nic dziwnego, że nie chce go wyjawiać. Ma się dobrze, Loganie. Ale Soubar jest w nielichych tarapatach. Bandyci i rozbójnicy atakują miasto, okoliczne osiedla i farmy. Spójrz na list, który do ciebie napisał.~
@33 = ~Dobrze, spójrzmy.~
@34 = ~Usiądź, <CHARNAME>. Zaraz go przeczytam.~
@35 = ~Napisał do mnie? Pokaż.~
@36 = ~Dlaczego nie usiądziesz, albo nie pójdziesz na piwo do Vyatri. Zapoznam się z tym, jeśli dasz mi szansę na przeczytanie tego w spokoju.~
@37 = ~<CHARNAME>, to czysta przyjemność, móc zrobić coś dla ciebie. Biorąc pod uwagę wszystkie twoje zasługi dla Targowa, przynajmniej to mogłem uczynić.~
@38 = ~Co cię znowu przywiodło do Targowa?~
@39 = ~Soubar jest w nielichych opałach. Próbuję pomóc miastu, w walce z bandytami i rozbójnikami, a prefekt prosił mnie, abym dostarczył ten list w nadziei, że im pomożesz. Przeczytaj chociaż ten list.~ ~Soubar jest w nielichych opałach. Próbuję pomóc miastu, w walce z bandytami i rozbójnikami, a prefekt prosił mnie, abym dostarczyła ten list w nadziei, że im pomożesz. Przeczytaj chociaż ten list.~
@40 = ~Prefekt Soubar nakazał dostarczyć mi ten list w nadziei, że pomożesz w ochronie miasta przed bandytami, którzy są głównym problemem miasta, okolicznych społeczności i farm, a także całego regionu. Możesz spojrzeć na ten list?~
@41 = ~Mam list dla ciebie. Dlaczego go nie przeczytasz, wszystko wyjaśnia.~
@42 = ~Na Torma! <CHARNAME>, dlaczego nie powiedziałeś tego od razu? Usiądź, podczas gdy ja będę go czytał.~ ~Na Torma! <CHARNAME>, dlaczego nie powiedziałaś tego od razu? Usiądź, podczas gdy ja będę go czytał.~
@43 = ~Na Torma, <CHARNAME>, powinieneś powiedzieć mi to w pierwszej kolejności. Pokaż mi go. Usiądź tymczasem i daj mi chwilę na jego przeczytanie.~ ~Na Torma, <CHARNAME>, powinnaś powiedzieć mi to w pierwszej kolejności. Pokaż mi go. Usiądź tymczasem i daj mi chwilę na jego przeczytanie.~
@44 = ~List? Pokaż go.~
@45 = ~To... to list od starego kumpla z oddziału, Żulesa. Przeczytam go dokładnie, <CHARNAME>, ale daj mi chwilę. Dlaczego nie wstąpisz obok - do Vytari - na posiłek, a ja w tym czasie się z tym zapoznam.~
@46 = ~<CHARNAME>, to smutne, ale nigdy się nie skończy, dopóki będziesz żyć. Myślę jednak, że tylko żartujesz sobie na temat własnych podróży. Czy jest coś, czego potrzebujesz?~
@47 = ~Tak, Loganie. Jest coś, czego potrzebuję. Wróciłem do Targowa z pewną przesyłką. Prefekt Soubar kazał mi dostarczyć ten list. Proszę, zobacz go.~ ~Tak, Loganie. Jest coś, czego potrzebuję. Wróciłam do Targowa z pewną przesyłką. Prefekt Soubar kazał mi dostarczyć ten list. Proszę, zobacz go.~
@48 = ~Mam list dla ciebie, Loganie. Powinieneś go przeczytać, wszystko wyjaśnia.~
@49 = ~List?~
@50 = ~Na Torma, <CHARNAME>, powinieneś powiedzieć mi o tym w pierwszej kolejności. Pokaż mi go. Usiądź tymczasem i daj mi chwilę na jego przeczytanie.~ ~Na Torma, <CHARNAME>, powinnaś powiedzieć mi o tym w pierwszej kolejności. Pokaż mi go. Usiądź tymczasem i daj mi chwilę na jego przeczytanie.~
@51 = ~<CHARNAME>, nigdy mi nie przerywaj. Nawet, gdybym był martwy - zawsze będzie mi przeszkadzać twoja obecność.~
@52 = ~<CHARNAME>, przykro mi, ale jestem zmuszony odpowiedzieć: nie. Zrozum, decyzja o tym nie należy do mnie. Muszę przekonać możnych Targowa - mogę uczynić jedynie to, na co mi zezwolą. A nie będzie to zadaniem łatwym.~
@53 = ~Obawiam się, że Targowo nie zrobi nic dla Soubar, będzie to hańba dla nas. Ale to przekracza moje możliwości. <CHARNAME>, przepraszam cię, ale musisz wrócić do Soubar bez jakiegokolwiek wsparcia.~
@54 = ~Proszę jednak, byś dał znać prefektowi, że zrobię wszystko, co w mojej mocy, aby udzielić wam pomocy w godzinie próby. Obiecuję, że powiadomię go najszybciej, jak to możliwe, ale obawiam się, że może być za późno.~ ~Proszę jednak, byś dała znać prefektowi, że zrobię wszystko, co w mojej mocy, aby udzielić wam pomocy w godzinie próby. Obiecuję, że powiadomię go najszybciej, jak to możliwe, ale obawiam się, że może być za późno.~
@55 = ~Nie lubi długo czekać, więc lepiej będzie, jeśli wrócisz, jak najszybciej.~
@56 = ~<CHARNAME>, powodzenia i uważaj na siebie.~
@57 = ~Morderco, jak śmiesz bezcześcić moje biuro. Do tej pory byłem spokojny, jednak, <CHARNAME>, jeśli dopraszasz się, bym użył przemocy lub ukarał cię za twe zbrodnie, uwierz mi, nie będę się wahał.~ ~Morderczyni, jak śmiesz bezcześcić moje biuro. Do tej pory byłem spokojny, jednak, <CHARNAME>, jeśli dopraszasz się, bym użył przemocy lub ukarał cię za twe zbrodnie, uwierz mi, nie będę się wahał.~
@58 = ~Przepraszam, że ci przeszkadzam, Loganie.~
@59 = ~Mam dość twoich zniewag. Tym razem wysłuchasz, co mam do powiedzenia.~
@60 = ~Jeśli jeszcze raz mnie obrazisz, Logan, to, Torm mi świadkiem, obiecuję, że będzie to ostatni raz, gdy kogoś znieważasz.~
@61 = ~Przeczytałeś list?~
@62 = ~Nie wierzę w twe przeprosiny. Uwierzę tylko wtedy, gdy będą szczere. A teraz, proszę, odejdź. Nie chce mi się z tobą gadać.~
@63 = ~Jak śmiesz mówić do mnie takim tonem? Co za tupet.~
@64 = ~Mogę cię nie lubić, Logan, i ty możesz nie lubić mnie, jednak jestem tu w sprawie naszego wspólnego znajomego, prefekta Soubar. Prosił, aby ci to dostarczyć. Proszę, przeczytaj ten list.~
@65 = ~Tylko przeczytaj. Proszę.~
@66 = ~Dobrze. Im szybciej przeczytam to, co mi przysłał, tym szybciej pozbędę się ciebie.~
@67 = ~Przepraszam. Zamierzam przeczytać to na osobności. Dlaczego nie pójdziesz sobie stąd i nie wrócisz za jakąś godzinę? Wtedy powinienem już skończyć.~
@68 = ~Co to? List?~
@69 = ~Przeczytam ten list. Zostaw mnie w spokoju na jakąś godzinę. Potem wróć.~
@70 = ~Tak, przeczytałem. Pomimo problemów, jakie wywołałeś tutaj w Targowie, zdecydowałem się pomóc mojemu staremu przyjacielowi Żulesowi.~ ~Tak, przeczytałem. Pomimo problemów, jakie wywołałaś tutaj w Targowie, zdecydowałem się pomóc mojemu staremu przyjacielowi Żulesowi.~
@71 = ~Ale nie mogę wysłać ludzi, aby poszli z tobą. Wrócisz do Soubar z pustymi rękami. Powiadom prefekta, że posiłki przybędą w ciągu dziesięciodnia.~
@72 = ~<CHARNAME>, to by było na tyle. Możesz iść~