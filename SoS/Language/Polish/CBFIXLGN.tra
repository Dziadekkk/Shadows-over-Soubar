@36 = ~Dlaczego nie usi¹dziesz, albo nie pójdziesz na piwo do Vyatri. Zapoznam siê z tym, jeœli dasz mi szansê na przeczytanie tego w spokoju.~
@37 = ~<CHARNAME>, to czysta przyjemnoœæ, móc zrobiæ coœ dla ciebie. Bior¹c pod uwagê wszystkie twoje zas³ugi dla Targowa, przynajmniej to mog³em uczyniæ.~
@38 = ~Co ciê znowu przywiod³o do Targowa?~
@39 = ~Soubar jest w nielichych opa³ach. Próbujê pomóc miastu, w walce z bandytami i rozbójnikami, a prefekt prosi³ mnie, abym dostarczy³ ten list w nadziei, ¿e im pomo¿esz. Przeczytaj chocia¿ ten list.~ ~Soubar jest w nielichych opa³ach. Próbujê pomóc miastu, w walce z bandytami i rozbójnikami, a prefekt prosi³ mnie, abym dostarczy³a ten list w nadziei, ¿e im pomo¿esz. Przeczytaj chocia¿ ten list.~
@40 = ~Prefekt Soubar nakaza³ dostarczyæ mi ten list w nadziei, ¿e pomo¿esz w ochronie miasta przed bandytami, którzy s¹ g³ównym problemem miasta, okolicznych spo³ecznoœci i farm, a tak¿e ca³ego regionu. Mo¿esz spojrzeæ na ten list?~
@41 = ~Mam list dla ciebie. Dlaczego go nie przeczytasz, wszystko wyjaœnia.~
@42 = ~Na Torma! <CHARNAME>, dlaczego nie powiedzia³eœ tego od razu? Usi¹dŸ, podczas gdy ja bêdê go czyta³.~ ~Na Torma! <CHARNAME>, dlaczego nie powiedzia³aœ tego od razu? Usi¹dŸ, podczas gdy ja bêdê go czyta³.~
@43 = ~Na Torma, <CHARNAME>, powinieneœ powiedzieæ mi to w pierwszej kolejnoœci. Poka¿ mi go. Usi¹dŸ tymczasem i daj mi chwilê na jego przeczytanie.~ ~Na Torma, <CHARNAME>, powinnaœ powiedzieæ mi to w pierwszej kolejnoœci. Poka¿ mi go. Usi¹dŸ tymczasem i daj mi chwilê na jego przeczytanie.~
@44 = ~List? Poka¿ go.~
@45 = ~To... to list od starego kumpla z oddzia³u, ¯ulesa. Przeczytam go dok³adnie, <CHARNAME>, ale daj mi chwilê. Dlaczego nie wst¹pisz obok - do Vytari - na posi³ek, a ja w tym czasie siê z tym zapoznam.~
@46 = ~<CHARNAME>, to smutne, ale nigdy siê nie skoñczy, dopóki bêdziesz ¿yæ. Myœlê jednak, ¿e tylko ¿artujesz sobie na temat w³asnych podró¿y. Czy jest coœ, czego potrzebujesz?~
@47 = ~Tak, Loganie. Jest coœ, czego potrzebujê. Wróci³em do Targowa z pewn¹ przesy³k¹. Prefekt Soubar kaza³ mi dostarczyæ ten list. Proszê, zobacz go.~ ~Tak, Loganie. Jest coœ, czego potrzebujê. Wróci³am do Targowa z pewn¹ przesy³k¹. Prefekt Soubar kaza³ mi dostarczyæ ten list. Proszê, zobacz go.~
@48 = ~Mam list dla ciebie, Loganie. Powinieneœ go przeczytaæ, wszystko wyjaœnia.~
@49 = ~List?~
@50 = ~Na Torma, <CHARNAME>, powinieneœ powiedzieæ mi o tym w pierwszej kolejnoœci. Poka¿ mi go. Usi¹dŸ tymczasem i daj mi chwilê na jego przeczytanie.~ ~Na Torma, <CHARNAME>, powinnaœ powiedzieæ mi o tym w pierwszej kolejnoœci. Poka¿ mi go. Usi¹dŸ tymczasem i daj mi chwilê na jego przeczytanie.~
@51 = ~<CHARNAME>, nigdy mi nie przerywaj. Nawet, gdybym by³ martwy - zawsze bêdzie mi przeszkadzaæ twoja obecnoœæ.~
@52 = ~<CHARNAME>, przykro mi, ale jestem zmuszony odpowiedzieæ: nie. Zrozum, decyzja o tym nie nale¿y do mnie. Muszê przekonaæ mo¿nych Targowa - mogê uczyniæ jedynie to, na co mi zezwol¹. A nie bêdzie to zadaniem ³atwym.~
@53 = ~Obawiam siê, ¿e Targowo nie zrobi nic dla Soubar, bêdzie to hañba dla nas. Ale to przekracza moje mo¿liwoœci. <CHARNAME>, przepraszam ciê, ale musisz wróciæ do Soubar bez jakiegokolwiek wsparcia.~
@54 = ~Proszê jednak, byœ da³ znaæ prefektowi, ¿e zrobiê wszystko, co w mojej mocy, aby udzieliæ wam pomocy w godzinie próby. Obiecujê, ¿e powiadomiê go najszybciej, jak to mo¿liwe, ale obawiam siê, ¿e mo¿e byæ za póŸno.~ ~Proszê jednak, byœ da³a znaæ prefektowi, ¿e zrobiê wszystko, co w mojej mocy, aby udzieliæ wam pomocy w godzinie próby. Obiecujê, ¿e powiadomiê go najszybciej, jak to mo¿liwe, ale obawiam siê, ¿e mo¿e byæ za póŸno.~
@55 = ~Nie lubi d³ugo czekaæ, wiêc lepiej bêdzie, jeœli wrócisz, jak najszybciej.~
@56 = ~<CHARNAME>, powodzenia i uwa¿aj na siebie.~
@57 = ~Morderco, jak œmiesz bezczeœciæ moje biuro. Do tej pory by³em spokojny, jednak, <CHARNAME>, jeœli dopraszasz siê, bym u¿y³ przemocy lub ukara³ ciê za twe zbrodnie, uwierz mi, nie bêdê siê waha³.~ ~Morderczyni, jak œmiesz bezczeœciæ moje biuro. Do tej pory by³em spokojny, jednak, <CHARNAME>, jeœli dopraszasz siê, bym u¿y³ przemocy lub ukara³ ciê za twe zbrodnie, uwierz mi, nie bêdê siê waha³.~
@58 = ~Przepraszam, ¿e ci przeszkadzam, Loganie.~
