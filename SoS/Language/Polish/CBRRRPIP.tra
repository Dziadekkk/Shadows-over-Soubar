@0    = ~Jedynym, co zrobiłem była próba zajęcia sobie czymś popołudnia! Po prostu grałem na fujarce!~
@1    = ~Te szczury zaczynają na mnie włazić! Co mam robić! One są wszędzie!~
@2    = ~Słuchaj, daj mi fujarkę, to wszystkie szczury odejdą.~
@3    = ~Przyjacielu, jedyne co musisz zrobić, to zacząć grać na fujarce w jakimś innym miejscu.~
@4    = ~Zapłaciłem za nią niezły kawał grosza. Nie chcę jej oddawać.~
@5    = ~Co jeśli kupiłbym ją od ciebie?~ ~Co jeśli kupiłabym ją od ciebie?~
@6    = ~Jeśli chcesz, żeby szczury zostawiły cię w spokoju, będziesz musiał oddać mi fujarkę.~
@7    = ~Naprawdę ją lubię. Raczej nie chcę jej sprzedawać.~
@8    = ~W innym miejscu? A czy szczury nie pójdą wtedy za mną?~
@9    = ~Tego nie wiem, ale warto spróbować.~
@10   = ~Być może, ale będą wtedy poza miastem.~
@11   = ~Nie przejmuj się tym, przyjacielu. Zabiję wszystkie szczury.~
@12   = ~Chciałbym jednak pozbyć się tych szczurów.~
@13   = ~Jeśli chcesz, żeby szczury zostawiły cię w spokoju, powinieneś oddać mi fujarkę.~
@14   = ~Jeśli przestaniesz grać, szczury zostawią cię w spokoju.~
@15   = ~Zatem zabieraj tę piekielną rzecz. Przyniosła mi tylko kłopoty.~
@16   = ~Zatem być może powinienem sprzedać ją z powrotem człowiekowi, od którego ją kupiłem. Niech on zajmie się szczurami.~
@17   = ~Muszę spróbować znaleźć zastaw i pozbyć się tej piekielnej rzeczy. Zobaczmy, czy możesz zrobić coś z tymi szczurami.~
@18   = ~Nie chcę, żeby za mną szły, chcę tylko grać na mojej fujarce.~
@19   = ~Zatem będę mógł grać na mojej fujarce?~
@20   = ~Jeśli przestaniesz grać, szczury zostawią cię w spokoju. Nie sądzę, żeby istniał jakiś inny sposób.~
@21   = ~Szczury nie zostawią cię w spokoju, jeśli nadal będziesz grał na fujarce. Powinieneś mi ją oddać.~