@0    = ~O raju, <CHARNAME>! To miasto roi się od pędzących gryzoni! To dosłowny wyścig szczurów!~
@1    = ~Wystarczy gadania, Tomas. Musimy pozbyć się tych szczurów. Pomóż mi je zabić.~
@2    = ~Tomas! Uważaj, nie pozwól, by cię ugryzły!~
@3    = ~Uwaga wszyscy! Znajdźcie krzesło, na którym można stanąć!~
@4    = ~Jeśli je zabijemy, rozsieją chorobę. <CHARNAME>, miasto zdruzgocze zaraza, a wtedy nie sądzę, byś nawet ty mógł komukolwiek pomóc.~ ~Jeśli je zabijemy, rozsieją chorobę. <CHARNAME>, miasto zdruzgocze zaraza, a wtedy nie sądzę, byś nawet ty mogła komukolwiek pomóc.~
@5    = ~Nie, musimy odkryć, skąd przychodzą i złapać je wszystkie.~
@6    = ~Musiałbym wtedy zgłosić się do leczenia. <CHARNAME>, jeśli te szczury ugryzą kogokolwiek, Athkatla ucierpi z powodu ogromnej zarazy. Nie, musimy odkryć skąd przychodzą, a następnie wyłapać je wszystkie nie pozwalając się skaleczyć.~
@7    = ~<CHARNAME>, gdzie mamy niby znaleźć krzesło na środku miejskich ulic?~
@8    = ~Tak czy inaczej nie zabijaj żadnych. <CHARNAME>, to spowoduje zarazę, jako że szczury mają zwyczaj roznosić choroby, a nie sądzę, żebyś nawet ty mógł komukolwiek wtedy pomóc.~ ~Tak czy inaczej nie zabijaj żadnych. <CHARNAME>, to spowoduje zarazę, jako że szczury mają zwyczaj roznosić choroby, a nie sądzę, żebyś nawet ty mogła komukolwiek wtedy pomóc.~
@9    = ~Hej, <CHARNAME>! Nie wiem, jaki jest twój zwykły sposób poszukiwania przygód, i zdaję sobie sprawę, że nie jestem w tej grupie zbyt długo, miałem jednak nadzieję, że możesz mi pomóc.~
@10   = ~Pasowałoby mi gdybyśmy mogli udać się na małą wyprawę do Athkatli, bo nie mogę się doczekać spotkania w mieście z moim starym przyjacielem.~
@11   = ~Nie w tej chwili, Tomas. Przypomnij mi za parę godzin.~
@12   = ~Jasne, Tomas. Kogo poszukujemy?~
@13   = ~Jest to mężczyzna znany jako Biff. Ostatnim razem gdy o nim słyszałem, brał udział w przesłuchaniu do roli w pewnej sztuce, więc domyślam się, że będziemy w stanie dowiedzieć się, czy dostał tę rolę czy nie, jeśli znajdziemy gdzieś tam teatr.~
@14   = ~O raju, <CHARNAME>! To Flecista z Athkatli!~
@15   = ~Jeśli nie chcesz, żeby zaraza pochłonęła miasto, sugerowałbym wykorzystanie tej fujarki do czegoś innego, niż granie na niej.~
@16   = ~Jeśli możesz się jakoś tego pozbyć, to będzie najlepsze rozwiązanie.~
@17   = ~Tak czy inaczej musimy wykombinować, co zrobić z tymi szczurami.~
@18   = ~<CHARNAME>, popatrz, wyrzucił fujarkę w tamtym miejscu! Zabierz ją, zanim szczury sprowadzą zarazę na miasto.~